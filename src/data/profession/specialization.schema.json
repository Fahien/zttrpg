{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "$id": "specialization.schema.json",
    "title": "Profession Specialization",
    "description": "A complete, playable specialization within a profession.",
    "type": "object",
    "additionalProperties": false,
    "required": ["name", "description", "skills", "heroic_skill", "items"],
    "properties": {
        "name": {
            "type": "string",
            "minLength": 1,
            "description": "The specialization name. Use Default when a profession has no choice."
        },
        "description": {
            "type": "string",
            "minLength": 1,
            "description": "A concise description of the specialization."
        },
        "skills": {
            "type": "array",
            "description": "The eight starting skills granted by this specialization.",
            "minItems": 8,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
                "$ref": "../skill-names.schema.json"
            }
        },
        "heroic_skill": {
            "anyOf": [
                { "$ref": "../skill-names.schema.json" },
                { "type": "null" }
            ],
            "description": "The starting heroic skill, or null when this specialization starts with magic instead."
        },
        "items": {
            "type": "array",
            "description": "The available starting-gear packages for this specialization.",
            "minItems": 1,
            "items": {
                "type": "array",
                "minItems": 1,
                "description": "One selectable starting-gear package.",
                "items": {
                    "$ref": "../item/item-names.schema.json"
                }
            }
        }
    }
}
