{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "$id": "item-kinds.schema.json",
    "title": "Item Kinds",
    "description": "A list of item kinds",
    "type": "object",
    "properties": {
        "$schema": {
            "type": "string",
            "description": "The schema version of the item kinds file."
        },
        "version": {
            "type": "string",
            "description": "The version of the item kinds file."
        },
        "item_kinds": {
            "type": "array",
            "items": {
                "$ref": "item-kind.schema.json"
            }
        }
    },
    "required": [
        "item_kinds"
    ]
}
