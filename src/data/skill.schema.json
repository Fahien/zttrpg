{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "$id": "skill.schema.json",
    "title": "Skill",
    "description": "A skill",
    "type": "object",
    "required": [
        "name",
        "icon",
        "kind",
        "description"
    ],
    "properties": {
        "$schema": {
            "type": "string",
            "description": "The schema version of the skill file."
        },
        "version": {
            "type": "string",
            "description": "The version of the skill file."
        },
        "name": {
            "$ref": "skill-names.schema.json"
        },
        "icon": {
            "$ref": "icon-names.schema.json",
            "description": "The icon of the skill."
        },
        "kind": {
            "$ref": "skill-kinds.schema.json"
        },
        "attribute": {
            "anyOf": [
                { "$ref": "attribute-names.schema.json" },
                { "type": "null" }
            ],
            "default": null,
            "description": "The governing attribute. Omit or use null for an ability."
        },
        "description": {
            "type": "string",
            "description": "The description of the skill."
        }
    }
}
