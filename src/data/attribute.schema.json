{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "$id": "attribute.schema.json",
    "title": "Attribute",
    "description": "An attribute",
    "type": "object",
    "properties": {
        "$schema": {
            "type": "string",
            "description": "The schema version of the attribute file."
        },
        "version": {
            "type": "string",
            "description": "The version of the attribute file."
        },
        "name": {
            "type": "string",
            "$ref": "attribute-names.schema.json",
            "description": "The name of the attribute."
        },
        "icon": {
            "$ref": "icon-names.schema.json",
            "description": "The icon of the attribute."
        },
        "short": {
            "type": "string",
            "description": "The short name of the attribute."
        },
        "description": {
            "type": "string",
            "description": "The description of the attribute."
        }
    }
}